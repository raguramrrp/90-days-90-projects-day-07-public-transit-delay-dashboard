# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env

# Testing & caches
.pytest_cache/
.coverage
htmlcov/

# Local databases & runtime state (keep SQLite db out of git)
data/transit.db
*.sqlite3
*.db-journal
data/powerbi_export/

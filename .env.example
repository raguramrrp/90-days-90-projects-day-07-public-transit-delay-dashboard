# Environment Configuration for Public Transit Delay Analytics Dashboard

# Database Connection (Default: local SQLite database for 1-click zero-setup execution)
# To use PostgreSQL, uncomment the PostgreSQL URL below and update credentials:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transit_analytics
DATABASE_URL=sqlite:///data/transit.db

# Application Configuration
APP_NAME="Public Transit Delay Analytics Dashboard"
APP_ENV=development
DEBUG=True
PORT=8501

# Data Generator Configuration
SAMPLE_DAYS=30
SAMPLE_TRIPS_PER_DAY=120
RANDOM_SEED=42

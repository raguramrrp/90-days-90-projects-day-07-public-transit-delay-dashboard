# ============================================================================
# Tirunelveli Public Transport Intelligence Platform (Nellai Transit)
# Environment Configuration
# ============================================================================

# Database Connection (Default: local SQLite database for 1-click zero-setup execution)
# To use PostgreSQL, set DATABASE_URL to your PostgreSQL instance:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transit_analytics
DATABASE_URL=sqlite:///data/transit.db

# Application Configuration
APP_NAME="Nellai Public Transport Live Tracker (Tirunelveli)"
APP_ENV=production
DEBUG=False
PORT=8501

# Regional Transport Scope
ACTIVE_REGION="Tamil Nadu (Tirunelveli District & Regional Corridors)"
DEFAULT_MAP_CENTER_LAT=8.7285
DEFAULT_MAP_CENTER_LON=77.7050

# Data Generator Configuration
SAMPLE_DAYS=30
SAMPLE_TRIPS_PER_DAY=80
RANDOM_SEED=42
